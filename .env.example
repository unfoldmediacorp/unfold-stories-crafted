# Copy to .env for local development. Values here are placeholders.
#
# Note: unlike most projects, `.env` IS committed here — Lovable manages it and
# stores the VITE_SUPABASE_* values in it. Vercel builds from the repo, so `.env`
# is what configures production too; no dashboard variables are needed. A
# VITE_-prefixed variable in the build environment still overrides `.env` if one
# is ever set. Never put a secret in it. See docs/MEDIA.md.

# Canonical site origin, used for canonical URLs, og:url, sitemap and JSON-LD.
# Until unfoldmediacorp.com resolves, point this at the deployment origin so
# crawlers are not sent to a domain that does not exist.
VITE_SITE_URL="https://unfoldmediacorp.com"

# --- Media (Cloudflare R2) -------------------------------------------------
# Public bucket origin, no trailing slash. See docs/MEDIA.md.
# Leave empty to fall back to poster images everywhere (no broken players).
# Live value (in .env): https://pub-9de675d6e8c7442b96ddaeeb50d43e49.r2.dev
VITE_MEDIA_BASE_URL=""

# Optional per-asset overrides. Object keys inside the bucket above.
# Set these to swap a cut without a code change; defaults live in src/lib/media.ts.
# VITE_MEDIA_HERO_DESKTOP="hero/hero-desktop.mp4"
# VITE_MEDIA_HERO_DESKTOP_WEBM="hero/hero-desktop.webm"
# VITE_MEDIA_HERO_MOBILE="hero/hero-mobile.mp4"

# --- Supabase --------------------------------------------------------------
# Managed by Lovable Cloud. The publishable key is public by design; the
# service-role key is injected at runtime and must never be committed.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
